PWA_AI_BASE_URL=https://api.openai.com/v1
PWA_AI_API_KEY=
PWA_AI_MODEL=
PWA_AI_TIMEOUT=90

# LaTeX builds only run in a preinstalled, network-disabled Docker image.
# The image must contain pdflatex plus bibtex and biber when bibliography builds are needed.
# There is no host-process fallback when this is empty or Docker is unavailable.
PWA_TEX_SANDBOX_IMAGE=
PWA_DOCKER_EXECUTABLE=docker
PWA_TEX_PIDS_LIMIT=128
PWA_TEX_MEMORY_MB=2048
PWA_TEX_CPU_LIMIT=2
PWA_LATEX_TIMEOUT_SECONDS=60
PWA_LATEX_ENGINE=pdflatex
PWA_BIB_ENGINE=auto

# 学术检索：默认 OpenAlex + Crossref + Semantic Scholar；可按部署环境收窄来源
PWA_ACADEMIC_SOURCES=openalex,crossref,semanticscholar
PWA_ACADEMIC_SEARCH_TIMEOUT=15
PWA_ACADEMIC_SEARCH_MAILTO=you@example.org
PWA_ACADEMIC_SEARCH_API_KEY=
PWA_SEMANTIC_SCHOLAR_API_KEY=
PWA_ACADEMIC_MAX_QUERY_VARIANTS=5
PWA_ACADEMIC_MAX_PAGES=3
